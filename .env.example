# ── .env.example ──────────────────────────────────────────────────────────
# 템플릿입니다. 다음으로 시작하세요:
#
#   cp .env.example .env && chmod 600 .env    # 키가 들어가므로 반드시
#   source .env
#
# ⚠️ .env 는 .gitignore 에 있습니다. 키를 이 파일(.env.example)에 적지 마세요.
#    커맨드라인 인자 대신 환경변수를 쓰는 이유: 이 서버는 /proc 에 hidepid 가
#    없어 다른 사용자가 ps 로 명령줄을 읽을 수 있습니다.
#
# 백본 프로파일은 두 가지입니다 (전환 절차: README.md "이 fork 에서 실행하기").
#   A. OpenRouter · meta-llama/llama-3.3-70b-instruct  ← 기본(원래) 프로파일, 아래에서 활성
#      config: LLMxMapReduce_V2/config/model_config_llama.json
#   B. Alibaba DashScope · qwen-plus-2025-12-01          ← kisti-2608-r7 파일럿 (2026-11-11~)
#      config: LLMxMapReduce_V2/config/model_config_qwen.json
#      파일 끝의 "프로파일 B" 블록 주석을 풀고 A 의 같은 변수는 지우거나 주석 처리하세요.

# ── LLM API (LLMxMapReduce_V2/request/openai.py 가 읽음) ──────────────────
# 백엔드는 OpenRouter (OpenAI 호환). 키는 https://openrouter.ai → Keys.
# ⚠️ 값 끝에 개행/공백이 들어가면 Authorization 헤더가 깨져 401이 납니다.
export OPENAI_API_KEY=sk-or-v1-여기에-본인-키
export OPENAI_API_BASE=https://openrouter.ai/api/v1

# ── 백본 프로파일 ─────────────────────────────────────────────────────────
# 모델 id 는 config/model_config_llama.json 에 있습니다 (모든 스테이지 동일 모델).
# 아래 두 값은 request/openai.py 의 env-gated 오버라이드 — 비우면 원본 동작.
#
# LLMXMR_PROVIDER: OpenRouter provider 핀 (endpoint tag). 고정하지 않으면 같은
#   모델이 서로 다른 quantization 의 provider 로 라우팅됩니다. tag 는 모델마다
#   다르므로 백본을 바꾸면 반드시 다시 조회하세요:
#     curl -s "https://openrouter.ai/api/v1/models/<model>/endpoints" \
#       | python -c "import json,sys; [print(e['tag'], e['quantization'], e['max_completion_tokens']) for e in json.load(sys.stdin)['data']['endpoints']]"
#
# LLMXMR_TEMPERATURE: 모든 호출에 일괄 적용. 코드는 temperature 를 넘기지 않으므로
#   비우면 provider 기본값이 쓰입니다. 0 이어도 비트 단위 재현은 보장되지 않지만
#   '같은 설정으로 돌렸다'를 기록 가능하게 합니다.
#
# LLMXMR_MAX_TOKENS / LLMXMR_RETRY_TRUNCATED: request/openai.py 의 출력 가드.
#   max_tokens 를 넘기고, finish_reason=length 인 응답은 ValueError(TruncatedResponseError)로
#   버려 모듈 retry(10~20회)가 새 샘플을 받게 합니다. 호출마다 completion_tokens 를
#   INFO 로그로 남기므로 첫 topic에서 가드 여유를 확인하세요 (scripts/run_manifest.py).

# LLMXMR_TRACK_COST: 1(기본)이면 OpenRouter usage accounting을 켜서 호출마다
#   크레딧 비용(usage.cost)을 응답으로 받아 INFO 로그로 남기고 세션 누적을 집계.
#   run 전/후 잔액 스냅샷은 scripts/check_credits.py 사용. OpenRouter가 아닌
#   백엔드가 usage 필드를 거부하면 0으로 끄세요. (빈 값은 unset 과 같이 기본값 1)
#
# LLMXMR_PRICE_IN / LLMXMR_PRICE_OUT: USD per 1M 토큰. 응답에 비용이 없는 백엔드(DashScope)용.
#   설정하면 호출마다 토큰 × 단가로 "Estimated cost" 를 로그에 남기고
#   scripts/run_manifest.py 가 estimated_cost_usd 로 합칩니다. 비우면 추정하지 않음.
#
# LLMXMR_DUMP_DIR (진단, 기본 꺼짐): 잘린 응답(finish_reason=length)을 프롬프트와 함께
#   <dir>/<NNNNN>_length.json 으로 저장 — 버려진 샘플이 '길지만 정상'인지 '반복 루프'인지 구분용.
#   LLMXMR_DUMP_MIN_COMPLETION=<n> 을 주면 completion_tokens ≥ n 인 정상 응답도 비교용으로 저장.
#   덤프에는 논문 원문 프롬프트가 들어가므로 커밋하지 않습니다 (.gitignore: data/kisti-2608-r7/*/diag*/).

## ▶ 활성: meta-llama/llama-3.3-70b-instruct (2026-08-31 ~)
export LLMXMR_PROVIDER=akashml/fp8   # fp8 / max_out 128K / $0.20·$0.52 per M
                                     # (AutoSurvey 쪽 2026-08-31 실측과 동일 핀 — 백본 통제 변수 공유)
export LLMXMR_TEMPERATURE=0.6        # 4 agent 공통 프로파일 (2026-09-07~). Meta 권장 기본값.
                                     # temp 0 금지 — llama가 반복 루프에 빠져 호출 하나가
                                     # 128K 토큰·45분까지 감 (AutoSurvey 실측). 재시도도 재표본이 안 됨.
export LLMXMR_MAX_TOKENS=8192        # 출력 잘림 가드 (분량 통제 아님). 정상 최대 출력은
                                     # digest·outline ≈ 4~5K 토큰 (edge 187편 실측) → 여유 약 1.7배.
                                     # 걸린 응답(finish_reason=length)은 버리고 재요청
                                     # (LLMXMR_RETRY_TRUNCATED=0 이면 유지). 비우면 원본 동작.
# 스모크 실측 (2026-08-31, Edge Computing, pool 20편·block_count 1):
#   28분 / 289 호출 / $0.472 (hidden $0.464 + decode $0.008) — 비용은 pool 크기에
#   거의 선형(digest가 지배). 본문 1,405단어(3섹션) — llama는 분량이 짧게 나오는
#   경향, pool이 커지면 skeleton도 커져 분량 증가 예상. 펜스 누락 fallback 4회 발동.

# ── 프롬프트 언어 (src/prompts) ───────────────────────────────────────────
export PROMPT_LANGUAGE=en

# ── NLTK (evaluation/agents/atomic_facts.py 의 sent_tokenize) ─────────────
# punkt/punkt_tab 은 이 경로에 이미 받아 두었습니다 (2026-08-31, llmxmr env 검증).
export NLTK_DATA=/data2/chanjoong/nltk_data_private

# ── 참고 ──────────────────────────────────────────────────────────────────
# · 평가(evaluation/)는 별도 judge 모델 축 — scripts/eval_all.sh 의 --eval_model 로 지정.
# · GOOGLE_API_KEY / SERP 계열 키는 온라인 검색(--topic) 경로 전용이며,
#   same-corpus 실험(--input_file)에서는 사용 금지이므로 설정하지 않습니다.

# ══ 프로파일 B: Alibaba DashScope · qwen-plus-2025-12-01 (kisti-2608-r7 파일럿) ══════════
# 쓰려면 아래 주석을 풀고, 위 프로파일 A 의 OPENAI_API_* / LLMXMR_PROVIDER 줄을 주석 처리하세요.
# stage3 에 --config_file ./config/model_config_qwen.json 을 함께 넘겨야 모델 id 가 바뀝니다.
# 키: Alibaba Cloud Model Studio (intl) → API Keys.
# export OPENAI_API_KEY=sk-여기에-DashScope-키
# export OPENAI_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# export LLMXMR_PROVIDER=            # OpenRouter 전용 — DashScope 에서는 비움 (extra_body.provider 안 보냄)
# export LLMXMR_TRACK_COST=0         # DashScope 는 usage.cost 를 주지 않음
# export LLMXMR_PRICE_IN=0.4         # qwen-plus-2025-12-01 입력 $/1M (캐시 할인 미반영 → 상한값)
# export LLMXMR_PRICE_OUT=1.2        # 출력 $/1M
# export LLMXMR_TEMPERATURE=0.6      # 4 agent 공통 프로파일 유지
# export LLMXMR_MAX_TOKENS=8192
# 주의: 계정 전체 120 RPM · 1M TPM (4 agent 공유). 429 BudgetLimitExceeded 는 rate limit 이 아니라
#   계정 예산 소진 — 재시도 루프가 계속 두드리므로 보이면 즉시 멈추고 예산을 올릴 것.
#   400 data_inspection_failed 는 재시도·입력 수정 없이 그 호출을 실패시키고 보고합니다.
